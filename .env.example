# Copy to .env and adjust. No Hugging Face token is required: every model used is public.

# Path to the raw Sentiment140 CSV (never committed, never served by the API)
S140_PATH=D:\Microsoft\sentiment analysis\archive\training.1600000.processed.noemoticon.csv

# Model cache on D: (C: has limited space)
HF_HOME=D:\huggingface
HF_HUB_CACHE=D:\huggingface\hub
TRANSFORMERS_CACHE=D:\huggingface\transformers

# Runtime code never downloads models
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Backend
ANALYTICS_DB=artifacts/analytics.db
CORS_ORIGINS=http://localhost:5173
# "auto" = use Qwen when installed and GPU is suitable, otherwise template fallback; "template" = always template
BRIEF_MODE=auto

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
